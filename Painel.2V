local G=getgenv and getgenv()or _G;G.LS=G.LS or{hot={},hooksOK=false,err=nil,done=false}
local CS,P,T,UIS=game:GetService"CollectionService",game:GetService"Players",game:GetService"TweenService",game:GetService"UserInputService"
local function se(v,d)d=d or 0;if v==nil then return"nil"end;local p=typeof(v)
if p=="string"then local s=v;if#s>80 then s=s:sub(1,77).."..."end;return string.format("%q",s)end
if p=="number"then if v~=v or v==math.huge or v==-math.huge then return tostring(v)end;return math.floor(v)==v and tostring(v)or string.format("%.2f",v)end
if p=="boolean"then return tostring(v)end;if p=="Instance"then return v:GetFullName()end
if p=="Vector3"then return string.format("V3(%.1f,%.1f,%.1f)",v.X,v.Y,v.Z)end
if p=="CFrame"then local o=v.Position;return string.format("CF(%.1f,%.1f,%.1f)",o.X,o.Y,o.Z)end
if p=="Color3"then return string.format("RGB(%d,%d,%d)",(v.R*255+.5)//1,(v.G*255+.5)//1,(v.B*255+.5)//1)end
if p=="BrickColor"then return"BC("..v.Name..")"end;if p=="EnumItem"then return tostring(v)end
if p=="function"or p=="thread"then return"<"..p..">"end
if p=="table"and d<2 then local r,n={},0;for k,x in pairs(v)do n=n+1;if n>5 then r[#r+1]="..."break end;r[#r+1]=tostring(k).."="..se(x,d+1)end;return"{"..table.concat(r,",").."}"end
return"<"..p..">"end
local hot=G.LS.hot
local function bp(k,kd,ex)local e=hot[k];if e then e.n=e.n+1;if ex then e.extra=ex end else hot[k]={n=1,k=kd,extra=ex}end end
if not G.LS.done then G.LS.done=true;local inH=false
local TR={FireServer=1,InvokeServer=1,FireAllClients=1,FireClient=1,InvokeClient=1,SetAttribute=1,GetAttribute=1,GetAttributes=1,AddTag=1,RemoveTag=1,HasTag=1,GetTags=1,GetTagged=1,GetDataStore=1,GetGlobalDataStore=1,GetOrderedDataStore=1}
local function h(s,a,m)if inH or not m or not TR[m]then return end;inH=true
pcall(function()
if m=="FireServer"or m=="InvokeServer"then local kd=s:IsA"RemoteFunction"and"RF"or"RE";local q={}
for i=1,math.min(#a,6)do q[#q+1]=se(a[i])end;local st=#q>0 and table.concat(q,", ")or"";if#a>6 then st=st..", +"..(#a-6)end
bp(s:GetFullName(),kd,{args=st})
elseif m=="FireAllClients"or m=="FireClient"then local st=(m=="FireClient")and 2 or 1;local q={}
for i=st,math.min(#a,st+5)do q[#q+1]=se(a[i])end;bp(s:GetFullName().." ["..m.."]","RE",{args=table.concat(q,", ")})
elseif m=="InvokeClient"then local q={}for i=2,math.min(#a,6)do q[#q+1]=se(a[i])end;bp(s:GetFullName().." [IC]","RF",{args=table.concat(q,", ")})
elseif m=="SetAttribute"or m=="GetAttribute"then local nm=tostring(a[1]);local ex={name=nm};if m=="SetAttribute"then ex.value=se(a[2])end;bp(s:GetFullName().."."..nm,"ATTR",ex)
elseif m=="GetAttributes"then bp(s:GetFullName()..".<all>","ATTR",{name="<all>"})
elseif m=="AddTag"or m=="RemoveTag"or m=="HasTag"then local n=a[1];local tg=a[2];local tn=(typeof(n)=="Instance")and n:GetFullName()or tostring(n);bp("CS "..tn.." ["..tostring(tg).."]","CS",{tag=tostring(tg)})
elseif m=="GetTags"then local n=a[1];local tn=(typeof(n)=="Instance")and n:GetFullName()or tostring(n);bp("CS GetTags "..tn,"CS",{})
elseif m=="GetTagged"then bp("CS GetTagged("..tostring(a[1])..")","CS",{tag=tostring(a[1])})
elseif m=="GetDataStore"or m=="GetGlobalDataStore"or m=="GetOrderedDataStore"then bp("DSS "..tostring(a[1]),"DSS",{name=tostring(a[1]),method=m})end
end)
inH=false end

-- ===== HOOK MASCARADO (anti-detect) =====
local ok,er=false,nil
if hookmetamethod and newcclosure then
    ok,er=pcall(function()
        local old_nc
        old_nc = hookmetamethod(game, "__namecall", newcclosure(function(self, ...)
            local args = {...}
            local method = getnamecallmethod()
            if not inH then
                inH = true
                pcall(function() h(self, args, method) end)
                inH = false
            end
            return old_nc(self, ...)
        end))
        if debug and debug.setinfo then
            pcall(function()
                debug.setinfo(old_nc, {
                    name = "namecall",
                    what = "C",
                    source = "[C]",
                    short_src = "[C]",
                    currentline = -1
                })
            end)
        end
    end)
end
if not ok and getrawmetatable and hookfunction and newcclosure then
    ok,er=pcall(function()
        local mt=getrawmetatable(game)
        local old_nc=mt.__namecall
        setreadonly(mt,false)
        mt.__namecall=newcclosure(function(self,...)
            local args=table.pack(...)
            local method
            pcall(function() method=getnamecallmethod() end)
            if not inH then
                inH = true
                pcall(function() h(self,args,method) end)
                inH = false
            end
            return old_nc(self,...)
        end)
        setreadonly(mt,true)
    end)
end
G.LS.hooksOK=ok
if not ok then G.LS.err=tostring(er) end end

